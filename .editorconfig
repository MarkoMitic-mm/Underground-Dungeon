root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.cs]
# Projektpräferenz: Kommentare in vorgeschlagenem/Generiertem Code sollen auf Deutsch sein.
# Diese Einstellung ist eine nicht-standardisierte Metainformation für AI- oder Tooling-Workflows.
x_preferred_comment_language = de

# C#-Coding-Stil-Grundsätze
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Editor-Config für Unity C# Dateien
# Verwende 4 Spaces, utf-8 und saubere Zeilenenden